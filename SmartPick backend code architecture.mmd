graph TD
    FE([Frontend\nNext.js]):::indigo

    subgraph API ["API Layer"]
        A1["POST /recommend\nPOST /recalculate\nPOST /compare"]:::teal
        A2["POST /advisor/ask"]:::teal
    end

    subgraph SERVICES ["Service Layer"]
        SV1[CardRecommendService\n필터링 + 혜택 계산 + 랭킹]:::violet
        SV2[ExplainService\nLLM 추천 설명 생성]:::violet
        SV3[AdvisorAgent\nTool-calling 루프]:::violet
    end

    subgraph PROMPTS ["Prompt Layer"]
        P1[prompts.py\nEXPLAIN_PROMPT_V4\nCOMPARE_PROMPT_V2\nQA_PROMPT]:::fuchsia
        P2[advise_service.py\nQUERIES_STANDALONE\nQUERIES_DETAILS]:::fuchsia
    end

    subgraph DATA ["Data Layer"]
        R1[CardRepository\njson_v4 카드 데이터]:::cyan
        R2[DigestRepository\n카드 요약 md]:::cyan
        R3[Terms · Manual Repos\n약관 · 상품설명서 md]:::cyan
        T1[BenefitCalculator\n혜택 계산 엔진]:::cyan
    end

    subgraph INFRA ["Core / Infra"]
        C1[resilience.py\nCircuit Breaker + Retry]:::orange
        C2[logger.py + middleware.py\n로깅 · PII 마스킹]:::orange
        C3[exceptions.py\n전역 예외처리]:::orange
    end

    subgraph EXTERNAL ["External Services"]
        EX1[(Supabase\nDB + Storage)]:::green
        EX2[Upstage Solar Pro 2\nLLM]:::green
        EX3[Naver · Tavily\n웹 검색]:::green
        EX4[BetterStack · Discord\n모니터링 · 알림]:::green
    end

    FE --> API
    A1 --> SV1 & SV2
    A2 --> SV3

    SV1 --> R1 & T1
    SV2 --> R2
    SV3 --> R3

    SV2 --> P1
    SV3 --> P2

    R1 & R2 & R3 --> EX1
    P1 & P2 --> C1 --> EX2
    SV3 --> EX3

    C2 --> EX4
    C3 --> EX4

